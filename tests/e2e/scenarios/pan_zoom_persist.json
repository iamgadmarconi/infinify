{
  "version": 1,
  "name": "pan, anchor zoom, inverse hit and persisted restore",
  "operations": [
    {
      "op": "add_output",
      "id": 1,
      "bounds": [
        100,
        50,
        800,
        600
      ],
      "camera": [
        0,
        0
      ],
      "zoom": 1
    },
    {
      "op": "add_window",
      "id": 10,
      "rect": [
        100,
        100,
        200,
        100
      ],
      "title": "Native identity independent geometry"
    },
    {
      "op": "assert_positions",
      "placements": [
        {
          "window": 10,
          "output": 1,
          "screen": [
            200,
            150,
            200,
            100
          ],
          "clip": [
            200,
            150,
            200,
            100
          ],
          "source": [
            0,
            0,
            200,
            100
          ]
        }
      ]
    },
    {
      "op": "assert_hit",
      "output": 1,
      "point": [
        250,
        175
      ],
      "window": 10,
      "local": [
        50,
        25
      ]
    },
    {
      "op": "zoom",
      "output": 1,
      "zoom": 0.5,
      "anchor": [
        200,
        150
      ]
    },
    {
      "op": "assert_positions",
      "placements": [
        {
          "window": 10,
          "output": 1,
          "screen": [
            200,
            150,
            100,
            50
          ]
        }
      ]
    },
    {
      "op": "assert_hit",
      "output": 1,
      "point": [
        225,
        162.5
      ],
      "window": 10,
      "local": [
        50,
        25
      ]
    },
    {
      "op": "pan",
      "output": 1,
      "delta": [
        20,
        10
      ]
    },
    {
      "op": "assert_positions",
      "placements": [
        {
          "window": 10,
          "output": 1,
          "screen": [
            180,
            140,
            100,
            50
          ]
        }
      ]
    },
    {
      "op": "save",
      "path": "session.json"
    },
    {
      "op": "set_window_rect",
      "window": 10,
      "rect": [
        10000,
        10000,
        200,
        100
      ]
    },
    {
      "op": "assert_positions",
      "placements": []
    },
    {
      "op": "load",
      "path": "session.json"
    },
    {
      "op": "assert_positions",
      "placements": [
        {
          "window": 10,
          "output": 1,
          "screen": [
            180,
            140,
            100,
            50
          ]
        }
      ]
    },
    {
      "op": "assert_hit",
      "output": 1,
      "point": [
        205,
        152.5
      ],
      "window": 10,
      "local": [
        50,
        25
      ]
    }
  ]
}
